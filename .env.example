# Copy to .env in THIS project, or inject INSIGHT_* environment variables.
# Viewing saved history/startup never calls models. New analysis requires PostgreSQL and an LLM.
INSIGHT_POSTGRES_URI=postgresql://insight:change-this-local-password@127.0.0.1:15432/insight_agents
INSIGHT_LLM_BASE_URL=
INSIGHT_LLM_API_KEY=
INSIGHT_LLM_MODEL=
INSIGHT_EMBEDDING_BASE_URL=
INSIGHT_EMBEDDING_API_KEY=
INSIGHT_EMBEDDING_MODEL=bge-m3

# DeepSeek-compatible evidence interpretation/review; routing and SQL remain non-thinking.
INSIGHT_LLM_ANALYSIS_THINKING=true
INSIGHT_LLM_REVIEW_THINKING=true
INSIGHT_LLM_REVIEW_EFFORT=low
INSIGHT_REVIEW_MAX_OUTPUT_TOKENS=12000
# Optional external readonly source credential, referenced by name in the UI.
# Export this in the backend process environment; it is never returned to the UI.
# INSIGHT_SOURCE_BUSINESS_PASSWORD=
